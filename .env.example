# ============================================================
# TruckConnect — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in ALL values before
# starting the application.  Remove any "# TODO" placeholder
# values before deploying to production.
#
# The application validates these variables at startup via
# /schemas/env.schema.ts (Zod). It will CRASH with a descriptive
# error if any required variable is missing or malformed.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev (docker-compose): postgresql://truckconnect:truckconnect_dev@localhost:5432/truckconnect
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/truckconnect

# ── Auth ─────────────────────────────────────────────────────
# Secret used to sign Auth.js (NextAuth) session tokens.
# Minimum 10 characters. In production use a strong random string:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-me-use-openssl-rand-base64-32

# Base URL of your application (no trailing slash).
# Must match the domain your app is served from.
# Examples:
#   Development : http://localhost:3000
#   Production  : https://truckconnect.example.com
NEXTAUTH_URL=http://localhost:3000

# ── Server ───────────────────────────────────────────────────
# Port for the combined HTTP + Socket.io server (legacy server.ts).
# Only required when running the custom server; optional with `next dev`.
SOCKET_PORT=3000

# ── Ably Realtime ─────────────────────────────────────────────
# API key from your Ably dashboard → Apps → API Keys.
# Format: <app-id>.<key-id>:<secret>  — keep this secret.
# Used server-side (REST publishes) AND to issue short-lived tokens to clients.
ABLY_API_KEY=your-app-id.key-id:secret

# ── MQTT (Eclipse Mosquitto) ──────────────────────────────────
# Broker URL for IoT sensor data ingestion. The sensor-consumer worker
# subscribes to trucknet/sensors/+/readings and trucknet/sensors/+/status.
# Local dev (docker-compose): mqtt://trucknet:your_mqtt_password@localhost:1883
MQTT_URL=mqtt://trucknet:your_mqtt_password@localhost:1883

# MQTT broker password — must match the Mosquitto passwd file.
# Generate passwd file: see docker/mosquitto/README.md
MQTT_PASSWORD=your_mqtt_password
