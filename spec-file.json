      "pages": ["app/(protected)/friends/page.tsx"],
      "keyFiles": [
        "app/api/friends/request/route.ts",
        "app/api/friends/list/route.ts",
        "app/api/friends/[id]/accept/route.ts",
        "app/api/friends/[id]/reject/route.ts",
        "app/api/friends/[id]/location/route.ts",
        "app/api/users/by-tag/route.ts"
      ],
      "dbTables": ["friend_requests"],
      "ablyEvents": ["friend_request_received", "friend_request_accepted"]
    },
    {
      "id": "FEAT-004",
      "name": "Real-Time GPS Tracking & Fleet Map",
      "status": "implemented",
      "description": "Drivers broadcast GPS coordinates every 20 seconds. Server upserts to DB and pushes a personalised nearby-driver list (within 50 km radius via Haversine) to each driver via Ably. Interactive Leaflet map shows nearby drivers as pins with names, avatars, distances. Clicking a pin opens messaging/call actions. Drivers can plot OSRM routes to a destination (result cached in Redis) and share live ETA as an overlay visible to admin. GPS positions are also ingested by the gps-position-worker for speed-violation and idle-excess event classification.",
      "routes": [
        "POST            /api/drivers/location",
        "GET             /api/drivers/nearby",
        "GET|POST|DELETE /api/drivers/route",
        "GET             /api/geocode?q=…"
      ],
      "pages": [
        "app/(protected)/map/page.tsx",
        "app/(protected)/dashboard/page.tsx"
      ],
      "keyFiles": [
        "components/map/DriverMap.tsx",
        "components/map/RouteSetupModal.tsx",
        "components/map/RouteInfoBar.tsx",
        "lib/haversine.ts",
        "lib/osrm.ts",
        "lib/route-cache.ts",
        "workers/gps-position-worker.ts"
      ],
      "dbTables": ["driver_locations", "driver_routes"],
      "ablyChannels": {
        "drivers": ["driver_location_updated", "driver_route_set", "driver_route_cleared"],
        "user:<userId>": ["nearby_driver_update"]
      }
    },
