    {
      "id": "FEAT-014",
      "name": "AI Camera Agent (Drowsiness & Distraction Detection)",
      "status": "implemented",
      "description": "Python ML agent running on the driver's cab laptop. Captures USB camera feed and runs two-layer detection: YOLOv8n-pose extracts a 17-point COCO skeleton per frame (CPU only, ~30 ms/frame), then EAR (Eye Aspect Ratio) and head-yaw geometry are computed. A trained RandomForest classifier (98% F1) validates geometric heuristics before publishing — suppressing false positives from poor lighting or partial occlusion. Detected events are published via MQTT to trucknet/drivers/{driverId}/behaviour and consumed by the behaviour-event-consumer worker. The TruckNet API issues a short-lived session token for MQTT broker authentication.",
      "routes": [
        "POST /api/cam-agent/session"
      ],
      "keyFiles": [
        "cam_agent/inference/",
        "cam_agent/models/",
        "cam_agent/training/",
        "cam_agent/config/",
        "cam_agent/live_test.py",
        "cam_agent/requirements.txt",
        "cam_agent/README.md",
        "cam_agent/docs/SETUP.md",
        "cam_agent/docs/DATASET_GUIDE.md"
      ],
      "pythonStack": {
        "poseEstimation": "YOLOv8n-pose (Ultralytics)",
        "classifier": "RandomForest (scikit-learn) — 98% F1 on drowsiness dataset",
        "videoCapture": "OpenCV",
        "mqttClient": "paho-mqtt",
        "hardware": "Any USB camera — 640×480 minimum, 10 fps; CPU only, no GPU required"
      },
      "detectedBehaviours": [
        "drowsiness_alert  — EAR < 0.25 sustained ≥ 2 s, RandomForest confirm",
        "microsleep_alert  — EAR < 0.20 sustained ≥ 3 s, RandomForest confirm",
        "distraction_alert — head yaw > 30° sustained ≥ 3 s"
      ],
      "mqttTopics": [
        "trucknet/drivers/{driverId}/behaviour  (QoS 1 — event JSON)"
      ],
      "notes": "Only events are transmitted — no video data ever leaves the cab."
    }
  ],

  "database": {
    "engine": "PostgreSQL 16",
    "orm": "Drizzle ORM",
    "migrations": "db/migrations/",
    "tables": [
      {
        "name": "users",
        "columns": ["id", "name", "email", "password_hash", "tag", "tag_number", "profile_image_url", "role (driver|admin)", "created_at"],
        "constraints": ["email UNIQUE", "tag UNIQUE"]
      },
      {
        "name": "driver_locations",
        "columns": ["id", "user_id FK→users", "latitude", "longitude", "updated_at"],
        "notes": "Upserted on each location broadcast"
      },
      {
        "name": "driver_routes",
        "columns": ["id", "driver_id FK→users", "origin_lat", "origin_lng", "destination_lat", "destination_lng", "destination_label", "route_geometry (JSON GeoJSON)", "distance_meters", "duration_seconds", "status (active|completed|cancelled)", "created_at", "completed_at"]
      },
      {
        "name": "text_messages",
        "columns": ["id", "sender_id FK→users", "receiver_id FK→users", "content", "status (delivered|read)", "created_at"],
        "indexes": ["(sender_id, receiver_id)"]
      },
      {
        "name": "voice_messages",
        "columns": ["id", "sender_id FK→users", "receiver_id FK→users", "audio_url", "duration_seconds", "status (delivered|listened)", "created_at"]
      },
      {
        "name": "stress_signals",
        "columns": ["id", "user_id FK→users", "latitude", "longitude", "status (active|resolved)", "created_at"],
        "indexes": ["(status, created_at)"]
      },
      {
        "name": "friend_requests",
        "columns": ["id", "sender_id FK→users", "receiver_id FK→users", "status (pending|accepted|rejected)", "created_at"],
        "constraints": ["UNIQUE (sender_id, receiver_id)"]
      },
      {
        "name": "call_history",
        "columns": ["id", "room_name UNIQUE", "caller_id FK→users", "callee_id FK→users", "call_type (voice|video)", "status (ongoing|completed|missed|declined)", "started_at", "ended_at", "duration_seconds", "created_at"]
      },
      {
        "name": "iot_devices",
        "columns": ["id", "device_id (unique text)", "truck_label", "status (online|offline|unknown)", "driver_id FK→users nullable", "last_seen_at", "firmware_version", "alert_config (JSON)", "created_at"]
      },
      {
        "name": "sensor_readings",
        "columns": ["id", "device_id FK→iot_devices", "temperature_c", "humidity_pct", "vibration_magnitude", "accel_x", "accel_y", "accel_z", "recorded_at"],
        "indexes": ["(device_id, recorded_at)"],
        "notes": "Time-series data, ~1 row per 5 seconds per device"
      },
      {
        "name": "sensor_alerts",
        "columns": ["id", "device_id FK→iot_devices", "driver_id FK→users nullable", "alert_type (temp_high|temp_low|humidity_high|vibration_high)", "value", "threshold", "status (active|acknowledged)", "triggered_at", "acked_by FK→users nullable", "acked_at nullable"]
      },
      {
        "name": "transport_trips",
        "columns": ["id", "driver_id FK→users", "route_id FK→driver_routes nullable", "vehicle_plate", "origin_label", "destination_label", "distance_km", "duration_minutes", "fuel_liters", "fuel_type (diesel|petrol|lpg|electric|hydrogen|cng|other)", "cargo_weight_kg", "is_empty_run", "load_factor_pct", "started_at", "completed_at", "status (active|completed|cancelled)", "behaviour_report_id FK→behaviour_reports nullable", "created_at", "created_by FK→users nullable"],
        "indexes": ["driver_id", "status", "started_at", "(driver_id, status)"],
        "notes": "Base table for all ESG transport metrics and behaviour scoring"
      },
      {
        "name": "driver_profiles",
        "columns": ["id", "driver_id FK→users (UNIQUE)", "gender", "birth_year", "nationality", "contract_type (cdi|cdd|interim|apprenticeship|other)", "contract_start_date", "contract_end_date", "weekly_hours_contractual", "driving_license_categories (JSON string[])", "license_obtained_year", "created_at", "updated_at", "created_by FK→users nullable"],
        "notes": "1-to-1 with users where role=driver"
      },
      {
        "name": "driver_shifts",
        "columns": ["id", "driver_id FK→users", "trip_id FK→transport_trips nullable", "shift_date", "started_at", "ended_at nullable", "break_minutes", "driving_minutes", "overtime_minutes", "night_shift", "status (active|completed|cancelled)", "driver_notes", "created_at", "updated_at"],
        "indexes": ["driver_id", "shift_date", "(driver_id, shift_date)"]
      },
      {
        "name": "vehicle_maintenance_logs",
        "columns": ["id", "driver_id FK→users nullable", "vehicle_plate", "maintenance_type (oil_change|tire_replacement|brake_service|technical_inspection|filter_replacement|battery|bodywork|fuel_fill|other)", "performed_at", "odometer_km", "cost_eur", "fuel_liters", "fuel_type", "provider_name", "next_due_at", "next_due_km", "regulatory_compliant", "notes", "document_url", "created_at", "updated_at"],
        "indexes": ["driver_id", "vehicle_plate", "performed_at", "maintenance_type"]
      },
      {
        "name": "driver_training_records",
        "columns": ["id", "driver_id FK→users", "training_type (license_renewal|adr_certification|eco_driving|defensive_driving|first_aid|cargo_handling|digital_tools|other)", "title", "provider", "completed_at", "duration_hours", "cost_eur", "certification_number", "expiry_date", "passed", "notes", "document_url", "created_at", "updated_at"],
        "indexes": ["driver_id", "completed_at", "training_type", "expiry_date"]
      },
      {
        "name": "driver_esg_reports",
        "columns": ["id", "driver_id FK→users", "period_type (weekly|monthly|quarterly|custom)", "period_start", "period_end", "total_trips", "empty_run_count", "empty_run_pct", "total_distance_km", "total_driving_hours", "total_shift_hours", "total_overtime_hours", "total_fuel_liters", "total_ghg_kgco2eq", "ghg_intensity_per_km", "ghg_intensity_per_tonne_km", "incident_count", "work_stoppage_count", "cargo_breach_count", "avg_cargo_temp_c", "maintenance_count", "training_hours", "certifications_count", "expiring_certifications_count", "trip_ids (JSON)", "shift_ids (JSON)", "incident_ids (JSON)", "maintenance_ids (JSON)", "training_ids (JSON)", "sensor_reading_count", "status (generating|ready|failed)", "error_message", "generated_at", "generated_by FK→users nullable", "created_at", "updated_at"],
        "indexes": ["driver_id", "(period_start, period_end)", "status"]
      },
      {
        "name": "esg_report_schedules",
        "columns": ["id", "period_type", "active", "hr_email", "language", "next_run_at", "last_run_at", "last_run_report_count", "created_at", "updated_at", "created_by FK→users nullable"]
      },
      {
        "name": "driving_events",
        "columns": ["event_id", "driver_id FK→users", "trip_id FK→transport_trips", "event_type (speed_violation|harsh_braking|harsh_acceleration|sudden_swerve|drowsiness_alert|microsleep_alert|distraction_alert|idle_excess|sos_triggered)", "severity (low|medium|high|critical)", "source (gps|esp32|ai_camera|driver)", "occurred_at", "duration_seconds", "gps_lat", "gps_lng", "gps_speed_kmh", "speed_limit_kmh", "speed_excess_kmh", "vibration_magnitude", "accel_x", "accel_y", "accel_z", "ear_value", "head_angle_deg", "confidence", "idle_duration_minutes", "metadata (JSON)", "created_at"],
        "indexes": ["driver_id", "trip_id", "event_type", "occurred_at", "source"],
        "notes": "Immutable event log from GPS worker, ESP32, and AI camera agent"
      },
      {
        "name": "behaviour_reports",
        "columns": ["behaviour_report_id", "driver_id FK→users", "trip_id FK→transport_trips (UNIQUE)", "global_score", "speed_score", "driving_style_score", "fatigue_score", "idle_score", "speed_violation_count", "max_speed_recorded_kmh", "max_speed_excess_kmh", "harsh_braking_count", "harsh_acceleration_count", "sudden_swerve_count", "drowsiness_alert_count", "microsleep_alert_count", "distraction_alert_count", "idle_excess_count", "total_idle_minutes", "sos_count", "total_events", "critical_events", "trip_distance_km", "trip_duration_hours", "events_per_100km", "status (generating|ready|failed)", "admin_reviewed", "admin_reviewed_by FK→users nullable", "admin_reviewed_at nullable", "admin_note", "generated_at", "created_at", "updated_at"],
        "indexes": ["driver_id", "trip_id", "global_score", "generated_at"]
      },
      {
        "name": "behaviour_scoring_config",
        "columns": ["config_id", "harsh_braking_threshold_g", "harsh_acceleration_threshold_g", "swerve_threshold_g", "speed_violation_excess_kmh", "idle_excess_minutes", "ear_drowsy_threshold", "ear_microsleep_threshold", "drowsy_duration_seconds", "microsleep_duration_seconds", "head_angle_distraction_deg", "distraction_duration_seconds", "weight_speed", "weight_driving_style", "weight_fatigue", "weight_idle", "weight_sos", "deduction_speed_minor", "...other score deduction fields"],
        "notes": "Single-row config table; system defaults used when empty"
      }
    ]
  },

  "realtime": {
    "provider": "Ably v2",
    "tokenEndpoint": "GET /api/auth/ably-token",
    "channels": {
      "user:<userId>": {
        "direction": "server → specific client",
        "events": ["nearby_driver_update", "text_message_received", "voice_message_received", "friend_request_received", "friend_request_accepted", "call_incoming", "call_declined", "call_missed", "call_ended", "stress_signal_alert"]
      },
      "drivers": {
        "direction": "server → all clients",
        "events": ["driver_location_updated", "driver_route_set", "driver_route_cleared"]
      },
      "stress:alerts": {
        "direction": "server → all clients",
        "events": ["stress_signal_alert"]
      },
      "sensors:<deviceId>": {
        "direction": "sensor-worker → admin device detail page",
        "events": ["sensor_reading", "device_status"]
      },
      "admin:sensors": {
        "direction": "sensor-worker → admin fleet page",
        "events": ["sensor_alert", "sensor_alert_acked", "fleet_sensor_update"]
      },
      "admin:behaviour": {
        "direction": "behaviour-worker → admin behaviour dashboard",
        "events": ["behaviour_report_ready", "critical_driving_event"]
      }
    }
  },

  "workers": [
    {
      "name": "stress-signal-consumer",
      "file": "workers/stress-signal-consumer.ts",
      "dockerService": "stress-worker",
      "transport": "Kafka",
      "consumes": ["trucknet.stress-signals"],
      "produces": "Ably: user:<driverId> + stress:alerts",
      "errorHandling": "Retry with exponential backoff, dead-letter to trucknet.stress-signals.dlq"
    },
    {
      "name": "sensor-consumer",
      "file": "workers/sensor-consumer.ts",
      "dockerService": "sensor-worker",
      "transport": "MQTT (Eclipse Mosquitto)",
      "consumes": ["trucknet/sensors/+/readings", "trucknet/sensors/+/status"],
      "produces": "PostgreSQL (sensor_readings, sensor_alerts, iot_devices) + Ably (sensors:<deviceId>, admin:sensors)",
      "errorHandling": "Zod validation rejects malformed payloads; alert deduplication prevents duplicate active alerts"
    },
    {
      "name": "behaviour-event-consumer",
      "file": "workers/behaviour-event-consumer.ts",
      "dockerService": "behaviour-event-worker",
      "transport": "MQTT (Eclipse Mosquitto)",
      "consumes": ["trucknet/drivers/+/behaviour"],
      "produces": "PostgreSQL (driving_events) + Ably (admin:behaviour critical_driving_event)",
      "errorHandling": "Zod validation; events with unknown trip_id are dropped with a warning"
    },
    {
      "name": "behaviour-report-worker",
      "file": "workers/behaviour-report-worker.ts",
      "dockerService": "behaviour-report-worker",
      "transport": "BullMQ (behaviour-reports queue)",
      "consumes": ["behaviour-reports queue jobs triggered on trip completion"],
      "produces": "PostgreSQL (behaviour_reports) + Ably (admin:behaviour behaviour_report_ready)",
      "errorHandling": "BullMQ retry with exponential backoff; failed reports marked in DB"
    },
    {
      "name": "gps-position-worker",
      "file": "workers/gps-position-worker.ts",
      "dockerService": "N/A (runs in main app process)",
      "transport": "GPS location stream from /api/drivers/location",
      "consumes": ["GPS coordinates posted by drivers"],
      "produces": "PostgreSQL (driving_events — speed_violation, idle_excess)",
      "errorHandling": "Speed limit lookup failures fall back gracefully; all events validated with Zod"
    },
    {
      "name": "driver-esg-report-worker",
      "file": "workers/driver-esg-report-worker.ts",
      "dockerService": "esg-worker",
      "transport": "BullMQ (driver-esg-reports queue)",
      "consumes": ["driver-esg-reports queue jobs"],
      "produces": "PostgreSQL (driver_esg_reports) + PDF/CSV files + email to HR via SMTP",
      "errorHandling": "Report status set to 'failed' with error_message stored; BullMQ retry with backoff"
    },
    {
      "name": "esg-report-scheduler",
      "file": "workers/esg-report-scheduler.ts",
      "dockerService": "esg-worker (same process as driver-esg-report-worker)",
      "transport": "Cron / scheduled timer",
      "consumes": ["esg_report_schedules table"],
      "produces": "BullMQ jobs (driver-esg-reports queue) for each driver in the fleet",
      "notes": "Runs on weekly/monthly/quarterly schedule; updates next_run_at after each execution"
    }
  ],

  "dockerServices": [
    { "name": "postgres",               "image": "postgres:16-alpine",             "ports": ["5433:5432"], "purpose": "Primary database" },
    { "name": "app",                    "image": "custom (Dockerfile)",            "ports": ["3000:3000"], "purpose": "Next.js application" },
    { "name": "livekit",                "image": "livekit/livekit-server:latest",  "ports": ["7880", "7881", "7882/udp"], "purpose": "WebRTC SFU" },
    { "name": "redis",                  "image": "redis:7-alpine",                 "ports": ["6379:6379"], "purpose": "OSRM route cache (LRU 128 MB) + BullMQ job backend" },
    { "name": "redisinsight",           "image": "redis/redisinsight:latest",      "ports": ["5540:5540"], "purpose": "Redis browser GUI" },
    { "name": "kafka",                  "image": "confluentinc/cp-kafka:7.4.0",    "ports": ["9092:9092"], "purpose": "Message broker (KRaft, no ZooKeeper)" },
    { "name": "kafka-ui",               "image": "provectuslabs/kafka-ui:latest",  "ports": ["8080:8080"], "purpose": "Kafka topic / consumer-lag GUI" },
    { "name": "stress-worker",          "image": "custom (Dockerfile.worker)",     "ports": [],           "purpose": "Stress signal Kafka consumer" },
    { "name": "sensor-worker",          "image": "custom (Dockerfile.worker)",     "ports": [],           "purpose": "MQTT IoT sensor consumer + DB writer" },
    { "name": "esg-worker",             "image": "custom (Dockerfile.esg-worker)", "ports": [],           "purpose": "BullMQ ESG report generator + email dispatcher (Puppeteer, Nodemailer)" },
    { "name": "behaviour-event-worker", "image": "custom (Dockerfile.worker)",     "ports": [],           "purpose": "MQTT cam_agent + ESP32 behaviour event consumer → driving_events" },
    { "name": "behaviour-report-worker","image": "custom (Dockerfile.worker)",     "ports": [],           "purpose": "BullMQ behaviour report scorer → behaviour_reports" },
    { "name": "mosquitto",              "image": "eclipse-mosquitto:2",            "ports": ["1883:1883", "9001:9001"], "purpose": "MQTT broker for ESP32 devices and AI camera agent" }
  ],

  "environmentVariables": [
    { "name": "DATABASE_URL",       "required": true,  "notes": "PostgreSQL connection string" },
    { "name": "NEXTAUTH_SECRET",    "required": true,  "notes": "JWT signing secret, min 10 chars" },
    { "name": "NEXTAUTH_URL",       "required": true,  "notes": "App canonical URL" },
    { "name": "ABLY_API_KEY",       "required": true,  "notes": "Ably REST + Realtime" },
    { "name": "KAFKA_BROKERS",      "required": true,  "default": "localhost:9092", "notes": "Comma-separated broker addresses" },
    { "name": "KAFKA_ENABLED",      "required": true,  "default": "false", "notes": "Toggle Kafka; falls back to direct Ably on false" },
    { "name": "LIVEKIT_URL",        "required": false, "notes": "LiveKit SFU URL (wss://…)" },
    { "name": "LIVEKIT_API_KEY",    "required": false, "notes": "LiveKit API key" },
    { "name": "LIVEKIT_API_SECRET", "required": false, "notes": "LiveKit API secret" },
    { "name": "ADMIN_INVITE_CODE",  "required": false, "notes": "Required when registering role=admin, min 8 chars" },
    { "name": "REDIS_URL",          "required": false, "notes": "Redis URL for OSRM route cache" },
    { "name": "MQTT_URL",           "required": false, "notes": "mqtt://user:pass@host:1883 — sensor worker only. @ in password must be %40" },
    { "name": "MQTT_PASSWORD",      "required": false, "notes": "Plain MQTT password — used by docker-compose healthcheck and workers" },
    { "name": "SOCKET_PORT",        "required": false, "notes": "Port override for Socket.IO" },
    { "name": "SMTP_HOST",          "required": false, "notes": "SMTP server hostname — required for ESG report email dispatch; skipped when unset" },
    { "name": "SMTP_PORT",          "required": false, "default": "587", "notes": "SMTP port" },
    { "name": "SMTP_USER",          "required": false, "notes": "SMTP authentication username" },
    { "name": "SMTP_PASS",          "required": false, "notes": "SMTP authentication password" },
    { "name": "SMTP_FROM",          "required": false, "default": "noreply@trucknet.local", "notes": "From address for ESG report emails" }
  ],

