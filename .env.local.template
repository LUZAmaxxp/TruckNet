# TruckConnect — Environment Variables Template
# Copy this file to .env.local and fill in all values before starting the application.
# The application will crash on startup if any variable below is missing or malformed.

# PostgreSQL database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/truckconnect

# Auth.js secret — minimum 10 characters, use a strong random string in production
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-minimum-10-chars

# Auth.js URL — the base URL of your application
NEXTAUTH_URL=http://localhost:3000

# Combined HTTP + WebSocket server port (Next.js and Socket.io share this port)
# When using server.ts (npm run dev), this is the port for the entire app.
# Must match the port in NEXTAUTH_URL above.
SOCKET_PORT=3000
